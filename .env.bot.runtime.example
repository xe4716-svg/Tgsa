# Separate Bot process; never give this role/key to customer browsers.
BOT_WORKER_DATABASE_URL=postgresql://tgs_bot_worker:replace-private-password@db:5432/tgs
# Preserve the existing Fernet business vault key. Never generate a replacement
# for a database that already contains encrypted Bot tokens/payloads.
BUSINESS_VAULT_KEY=
BOT_WORKER_ID=
# Assigned BUSINESS tenant UUIDs, comma-separated; require existing root mappings.
BOT_TENANT_IDS=
