POSTGRES_PASSWORD=replace-with-a-long-random-postgres-password
APP_DB_PASSWORD=replace-with-a-different-long-random-app-password
DATABASE_URL=postgresql://tgs_runtime:replace-with-a-different-long-random-app-password@db:5432/tgs
REDIS_URL=redis://redis:6379/0
APP_ENV=development
APP_NAME=TG SaaS API

# Telegram developer credentials. Store production values in a secret manager.
TG_API_ID=
TG_API_HASH=

# Base64-encoded 32-byte key. Production should use KMS/HSM envelope encryption.
SESSION_KEK_BASE64=
SESSION_KEK_ID=local-dev-key-v1

# Generate a random secret of at least 32 characters.
JWT_SIGNING_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Local Docker uses Mailpit. Production: configure authenticated SMTP with TLS.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false
SMTP_USE_TLS=false
EMAIL_FROM=no-reply@tgs.local
EMAIL_VERIFICATION_URL=http://localhost:3000/verify-email
PASSWORD_RESET_URL=http://localhost:3000/reset-password


# Payment public URLs. Production URLs must be HTTPS and publicly reachable.
PUBLIC_API_BASE_URL=https://api.example.com
PAYMENT_RETURN_URL=https://app.example.com/wallet
MANUAL_PAYMENT_CONTACT_URL=

# Stripe Checkout (credit/debit cards). Keep keys in the deployment secret manager.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Alipay Open Platform (RSA2). PEM values may use literal \n line breaks.
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY_PEM=
ALIPAY_PUBLIC_KEY_PEM=
ALIPAY_GATEWAY_URL=https://openapi.alipay.com/gateway.do

# WeChat Pay API v3 Native. Platform certificate is required to verify callbacks.
WECHAT_MCHID=
WECHAT_APPID=
WECHAT_SERIAL_NO=
WECHAT_PRIVATE_KEY_PEM=
WECHAT_API_V3_KEY=
WECHAT_PLATFORM_CERT_PEM=
WECHAT_API_BASE_URL=https://api.mch.weixin.qq.com

# Common Epay-compatible gateway. This protocol is not universal; confirm compatibility with the provider.
EASYPAY_GATEWAY_URL=
EASYPAY_PID=
EASYPAY_KEY=

# TRON USDT TRC20. Use an account-level (m/44'/195'/0') or external-chain
# (m/44'/195'/0'/0) extended PUBLIC key only. Never put a seed/private key here.
TRON_API_BASE_URL=https://api.trongrid.io
TRONGRID_API_KEY=
TRON_USDT_CONTRACT=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t
TRON_ACCOUNT_XPUB=
TRON_WATCHER_ENABLED=false
TRON_WATCH_INTERVAL_SECONDS=60
TRON_WATCH_BATCH_SIZE=20
